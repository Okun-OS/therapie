// ── Planning Policy (Phase 9) ─────────────────────────────────────────────────
// Human-readable admin configuration that governs how the solver run is evaluated.
// One record per location; upserted by PUT /api/planning-policy.

model PlanningPolicy {
  locationId              String    @id
  customerId              String
  // How to treat employees with excess hours before the planning run
  defaultOvertimeHandling String    @default("normal") // reduce | normal | compensate
  // Minimum quality score required for automatic approval (0–100)
  minAutoApproveScore     Float     @default(80)
  // Abort the run immediately when the solver reports INFEASIBLE (vs. partial plan)
  failFastOnInfeasible    Boolean   @default(true)
  // Deadline by which employees must submit their wishes; after this the scheduler locks input
  requestDeadline         DateTime?
  updatedAt               DateTime  @updatedAt

  @@index([customerId])
}

// ── Employee Requests (Phase 8) ──────────────────────────────────────────────
// Structured employee requests: single source of truth for all request types.
// Complements WishSubmission (per-date soft wishes) with a richer model that
// covers vacations, absences, overtime adjustments and date-range requests.

model EmployeeRequest {
  id          String    @id @default(cuid())
  employeeId  String
  locationId  String
  customerId  String
  // Type of request (mirrors EmployeeRequestType in company-model-types.ts)
  type        String // shift_wish | day_off_wish | vacation | absence | overtime_reduce | overtime_compensate
  status      String    @default("pending") // pending | approved | rejected | expired
  priority    String    @default("normal") // low | normal | high | critical
  // Day-specific requests
  date        String?
  // Range requests (vacation, absence, consecutive days off)
  dateFrom    String?
  dateTo      String?
  // For shift_wish: which shift
  shiftId     String?
  reason      String?
  // Audit
  submittedAt DateTime  @default(now())
  respondedAt DateTime?
  respondedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId])
  @@index([locationId])
  @@index([customerId])
}

