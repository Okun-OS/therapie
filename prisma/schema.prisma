// Prisma schema for the new Vertretungsmanagement (substitution management) module.
// Existing app data stays in src/lib/mock-data.ts on purpose – this schema only
// covers the new, persisted module so existing functionality is untouched.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubstitutionStatus {
  open
  filled
  cancelled
  expired
}

enum SubstitutionPriority {
  low
  normal
  high
  urgent
}

enum EscalationStage {
  group
  location
  organization
  springerpool
}

enum CandidateResponseStatus {
  pending
  accepted
  declined
  expired
}

// Additive metadata for an existing mock-data Employee (kept separate from
// mock-data.ts so the existing employee directory is never modified).
model EmployeeProfile {
  employeeId     String   @id
  isSpringer     Boolean  @default(false)
  qualifications String[] @default([])
  groupId        String?
  updatedAt      DateTime @updatedAt
}

// ─── Menschliche Dienstplanung (Modul 8) ────────────────────────────────────
// Voluntary, employee-controlled soft signals for fairer/more human scheduling.
// Kept separate from EmployeeProfile (which serves substitution matching) so
// the two audiences/purposes never get entangled.
model EmployeeHumanContext {
  employeeId          String   @id
  strengths           String[] @default([])
  lifeCircumstances   String[] @default([])
  preferredGroups     String[] @default([])
  preferredActivities String[] @default([])
  shiftPreferences    String[] @default([])
  agreements          String?
  updatedAt           DateTime @updatedAt
}

model SubstitutionRequest {
  id                 String                  @id @default(cuid())
  locationId         String
  groupId            String?
  date               String
  startTime          String
  endTime            String
  qualification      String?
  priority           SubstitutionPriority    @default(normal)
  status             SubstitutionStatus      @default(open)
  escalationStage    EscalationStage         @default(group)
  note               String?
  createdBy          String
  createdAt          DateTime                @default(now())
  filledByEmployeeId String?
  filledAt           DateTime?
  candidates         SubstitutionCandidate[]
}

model SubstitutionCandidate {
  id              String                  @id @default(cuid())
  requestId       String
  request         SubstitutionRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  employeeId      String
  employeeName    String
  matchScore      Int
  matchReasons    String[]                @default([])
  escalationStage EscalationStage
  responseStatus  CandidateResponseStatus @default(pending)
  notifiedAt      DateTime?
  respondedAt     DateTime?
  createdAt       DateTime                @default(now())

  @@unique([requestId, employeeId])
}

model PushSubscription {
  id         String   @id @default(cuid())
  employeeId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
}

model Notification {
  id         String   @id @default(cuid())
  employeeId String
  type       String
  title      String
  body       String
  requestId  String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ─── Workforce Score (Modul 3: Gamification) ────────────────────────────────
// Additive module. The existing mock-data TimeLog (src/lib/mock-data.ts) stays
// untouched as seed/history data; this model is the new, real persistence
// layer for the clock-in/out action so punctuality can actually be scored.

enum WorkforceLevel {
  bronze
  silber
  gold
  platin
  diamant
}

model TimeClockEntry {
  id         String    @id @default(cuid())
  employeeId String
  date       String
  locationId String
  clockIn    DateTime
  clockOut   DateTime?
  createdAt  DateTime  @default(now())
}

model ScoreEvent {
  id         String   @id @default(cuid())
  employeeId String
  points     Int
  reason     String
  type       String
  relatedId  String?
  createdAt  DateTime @default(now())

  @@unique([type, relatedId])
}

model LevelBonusConfig {
  level     WorkforceLevel @id
  bonusText String?
  updatedAt DateTime       @updatedAt
}

// ─── KI-Onboarding (Modul 02) ────────────────────────────────────────────────
// Zweistufiges Onboarding per KI-Chat statt klassischem Formular.
// Ebene 1 (Träger): trägerweite Angaben, einmalig, ein Datensatz pro Mandant.
// Ebene 2 (Einrichtung): pro Standort (mock-data Location) eigene Konfiguration –
// "Das System darf niemals einfach die Regeln einer anderen Einrichtung kopieren."
// customerId statt fixer 'singleton'-PK: jeder Mandant (Customer) bekommt seinen
// eigenen Datensatz, sonst sehen alle Träger dieselben Onboarding-Daten.
model OrganizationOnboarding {
  customerId              String   @id
  traegerName             String?
  rollenmodell            String?
  unternehmensweiteRegeln String?
  completed               Boolean  @default(false)
  updatedAt               DateTime @updatedAt
}

model LocationOnboarding {
  locationId             String   @id
  einrichtungsart        String?
  organisationsstruktur  String?
  personalstruktur       String?
  arbeitszeiten          String?
  dienstplanlogik        String?
  pausenlogik            String?
  wiederkehrendeAufgaben String?
  individuelleRegeln     String[] @default([])
  vertretungsregeln      String?
  urlaubslogik           String?
  zeiterfassung          String?
  besonderheiten         String?
  tagesablauf            String?
  completedPhases        String[] @default([])
  completed              Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

// ─── Google-Kalender-Synchronisation (Modul 04/05/06) ───────────────────────
// Statt einer OAuth-Anbindung (erfordert Google-Cloud-Zugangsdaten, die hier
// nicht vorliegen) nutzen wir einen klassischen, token-basierten ICS-Feed:
// der Mitarbeiter abonniert die Feed-URL einmalig in Google/Apple Kalender,
// danach hält der Kalender-Anbieter den Plan automatisch aktuell, da der
// Feed bei jedem Abruf live aus dem aktuellen Dienstplan generiert wird.
model EmployeeCalendarSync {
  employeeId String   @id
  enabled    Boolean  @default(false)
  token      String   @unique @default(cuid())
  updatedAt  DateTime @updatedAt
}

// Ergänzung 4 zu 02_ONBOARDING_CHAT.md: kurzfristige, nur für die jeweils
// aktuelle Planungsperiode gültige Besonderheiten (z.B. "Diese Woche findet
// ein Sommerfest statt"). Bewusst getrennt von LocationOnboarding, da diese
// Hinweise gerade NICHT dauerhaft gelten sollen.
model SchedulingPeriodNote {
  id         String   @id @default(cuid())
  locationId String
  weekStart  String
  note       String
  createdAt  DateTime @default(now())
}

// ─── Echte Authentifizierung & Einladungen (Demo → Produktivsystem) ────────
// Ersetzt die rein clientseitige Demo-Anmeldung durch echte, gehashte
// Passwörter. employeeId/locationId/customerName verknüpfen den Account
// optional mit den bestehenden mock-data Entitäten, ohne diese anzufassen.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  employeeId   String?
  locationId   String?
  customerId   String?
  customerName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InvitationToken {
  id           String    @id @default(cuid())
  token        String    @unique
  email        String
  role         String
  name         String?
  customerId   String?
  customerName String?
  employeeId   String?
  locationId   String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
}

// Separat von InvitationToken: zielt auf bestehende Accounts (nicht auf
// Neuanlage) und ist bewusst kurzlebig (1 Stunde statt 7 Tage).
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─── Echte Datenpersistenz: Mitarbeiter/Kunden/Standorte ───────────────────
// Ersetzt die bisherigen EMPLOYEES/LOCATIONS/CUSTOMERS Arrays in
// mock-data.ts. Bewusst ohne @relation (wie der Rest des Schemas) – alle
// Querverweise (locationId, adminId, employeeId, ...) bleiben lose Strings,
// damit bestehende Tabellen (EmployeeProfile, User, ...) unverändert bleiben.
model Location {
  id            String   @id @default(cuid())
  customerId    String?
  name          String
  address       String
  city          String
  state         String
  employeeCount Int      @default(0)
  adminId       String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Employee {
  id                String   @id @default(cuid())
  customerId        String?
  name              String
  email             String   @unique
  role              String
  locationId        String?
  weeklyHours       Float
  position          String
  hoursBalance      Float    @default(0)
  vacationDaysTotal Int      @default(30)
  vacationDaysUsed  Int      @default(0)
  preferences       Json?
  active            Boolean  @default(true)
  joinedAt          String
  hasChildren       Boolean?
  phone             String?
  birthDate         String?
  roleType          String?
  employmentType    String?
  gruppe            String?
  bereich           String?
  multiGroupCapable Boolean?
  fixedLocations    String?
  qualifications    String[] @default([])
  allowedTasks      String[] @default([])
  workDaysPerWeek   Int?
  workDays          String[] @default([])
  dailyTargetHours  Float?
  fixedOffDays      String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  contactName    String
  contactEmail   String
  status         String
  plan           String
  seatsLicensed  Int
  seatsUsed      Int      @default(0)
  locationsCount Int      @default(0)
  createdAt      String
  renewalDate    String?
  notes          String?
  roles          String[] @default([])
  updatedAt      DateTime @updatedAt
}

// ─── Echte Datenpersistenz: Dienstplanung, Zeiterfassung, Urlaub, Plattform ─
// Ersetzt die übrigen, bisher noch simulierten Arrays in src/lib/mock-data.ts
// (Shift, ScheduleEntry, TimeLog, VacationRequest, ...). Wie der Rest des
// Schemas ohne @relation – alle Querverweise bleiben lose Strings. Bewusst
// ohne Seed-Daten: Produktivsysteme starten leer, echte Daten entstehen durch
// echte Nutzung der Anwendung ("keine Demo-Daten mehr").

model Shift {
  id         String   @id @default(cuid())
  name       String
  type       String
  startTime  String
  endTime    String
  color      String
  bgColor    String
  minStaff   Int      @default(1)
  locationId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ScheduleEntry {
  id              String   @id @default(cuid())
  employeeId      String
  shiftId         String
  date            String
  locationId      String
  status          String   @default("planned")
  note            String?
  reason          String?
  startTime       String?
  endTime         String?
  gruppe          String?
  funktion        String?
  isSubstitution  Boolean  @default(false)
  substitutionFor String?
  taskBlocks      Json?
  createdAt       DateTime @default(now())
}

model LocationPlanningRules {
  locationId            String    @id
  maxWeeklyHours        Int       @default(40)
  restHours             Int       @default(11)
  maxConsecutiveDays    Int       @default(5)
  fridayLateMax         Int       @default(2)
  mondayEarlyMax        Int       @default(3)
  fridayEarlyMax        Int       @default(3)
  weekendMax            Int       @default(2)
  considerWishes        Boolean   @default(true)
  balanceHoursAccount   Boolean   @default(true)
  autoBreakDeduction    Boolean   @default(false)
  breakThresholdMinutes Int       @default(360)
  breakDeductionMinutes Int       @default(30)
  breakRulesExtractedAt DateTime?
  updatedAt             DateTime  @updatedAt
}

model TimeLog {
  id           String    @id @default(cuid())
  employeeId   String
  date         String
  clockIn      String
  clockInAt    DateTime?
  clockOut     String?
  totalMinutes Int?
  breakMinutes Int?
  breakStart   String?
  breakStartAt DateTime?
  note         String?
  locationId   String
  createdAt    DateTime  @default(now())
}

model VacationRequest {
  id           String   @id @default(cuid())
  employeeId   String
  employeeName String
  locationId   String
  locationName String
  startDate    String
  endDate      String
  days         Int
  reason       String?
  status       String   @default("pending")
  submittedAt  String
  respondedAt  String?
  respondedBy  String?
  createdAt    DateTime @default(now())
}

model SwapRequest {
  id                 String    @id @default(cuid())
  requesterId        String
  requesterName      String
  requesterDate      String
  requesterShiftId   String
  targetEmployeeId   String
  targetEmployeeName String
  targetDate         String
  targetShiftId      String
  message            String?
  status             String    @default("pending")
  submittedAt        String
  respondedAt        String?
  locationId         String
}

model WishSubmission {
  id                 String   @id @default(cuid())
  employeeId         String
  employeeName       String
  locationId         String
  date               String
  preferredShiftType String
  reason             String?
  importance         String   @default("normal")
  submittedAt        String
  status             String   @default("pending")
  conflictInfo       Json?
}

model VacationPlanPreference {
  employeeId            String   @id
  hasChildren           Boolean  @default(false)
  schoolHolidayPriority String?
  preferredMonths       Int[]    @default([])
  preferredPeriod       String?
  notes                 String?
  priority              String   @default("medium")
  updatedAt             DateTime @updatedAt
}

model VacationRules {
  locationId                String   @id
  facilityDescription       String
  maxConcurrent             Int
  customRules               String[] @default([])
  schoolHolidayPriorityMode String   @default("none")
  updatedAt                 DateTime @updatedAt
}

model TaskType {
  name      String   @id
  createdAt DateTime @default(now())
}

model TestAccount {
  id           String  @id @default(cuid())
  customerName String
  contactEmail String
  createdAt    String
  expiresAt    String
  converted    Boolean @default(false)
}

// Plattformweite Einladungen an potenzielle Kunden (Vertrieb) – getrennt von
// InvitationToken, das echte Konten innerhalb eines bestehenden Mandanten anlegt.
model PlatformInvitation {
  id           String  @id @default(cuid())
  email        String
  role         String
  customerName String?
  status       String  @default("pending")
  sentAt       String
}

model SupportAccessLogEntry {
  id           String  @id @default(cuid())
  customerName String
  requestedBy  String
  reason       String
  grantedAt    String
  revokedAt    String?
}

model OrgSettings {
  customerId                   String   @id
  organizationName             String
  defaultWeeklyHours           Int
  defaultVacationDaysPerYear   Int
  autoApproveVacationUnderDays Int
  notificationEmail            String
  updatedAt                    DateTime @updatedAt
}

model OvertimeRequest {
  id              String   @id @default(cuid())
  employeeId      String
  employeeName    String
  locationId      String
  date            String
  timeLogId       String
  overtimeMinutes Int
  reason          String
  comment         String?
  status          String   @default("pending")
  approvedMinutes Int?
  adminComment    String?
  respondedAt     String?
  respondedBy     String?
  submittedAt     String
}

model Absence {
  id                 String   @id @default(cuid())
  employeeId         String
  employeeName       String
  locationId         String
  type               String
  startDate          String
  endDate            String
  days               Int
  note               String?
  proofProvided      Boolean  @default(false)
  verificationStatus String   @default("offen")
  verifiedBy         String?
  verifiedAt         String?
  submittedAt        String
}

// ─── Schließzeiten / Pflichturlaub ───────────────────────────────────────────
// Feste, vom Standort vorgegebene Schließzeiten (Betriebsferien, Kita-Schließzeit,
// Brückentage, ...). Beim Anlegen werden automatisch Urlaubsanträge (status
// 'approved', respondedBy 'System (Schließzeit)') für alle betroffenen aktiven
// Mitarbeiter erzeugt – nur für tatsächliche Arbeitstage (siehe lib/workdays.ts).
model ClosurePeriod {
  id         String   @id @default(cuid())
  locationId String
  name       String
  startDate  String
  endDate    String
  createdBy  String
  createdAt  DateTime @default(now())
}

// ─── Planungseinheiten (frei konfigurierbarer Einsatzplan) ──────────────────
// Durch das Onboarding definierte benannte Einheiten eines Standorts:
// Gruppen, Bereiche, Objekte, Touren, Fahrzeuge, Maschinen, Räume, Stationen.
// Nur echte, vom Nutzer genannte Einheiten – niemals durch die KI erfunden.
model PlanningUnit {
  id          String   @id @default(cuid())
  locationId  String
  name        String
  type        String   @default("bereich")
  description String?
  capacity    Int?
  address     String?
  notes       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locationId])
}

model MonthlyClosing {
  id               String  @id @default(cuid())
  employeeId       String
  employeeName     String
  locationId       String
  year             Int
  month            Int
  status           String  @default("offen")
  arbeitstage      Int
  sollMinutes      Int
  istMinutes       Int
  breakMinutes     Int
  overtimeMinutes  Int
  undertimeMinutes Int
  vacationDays     Int
  sickDays         Int
  otherAbsenceDays Int
  approvalsCount   Int
  comments         Json    @default("[]")
  reviewedBy       String?
  reviewedAt       String?
  releasedBy       String?
  releasedAt       String?

  @@unique([employeeId, year, month])
}
