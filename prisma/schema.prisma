  defaultWeeklyHours           Int
  defaultVacationDaysPerYear   Int
  autoApproveVacationUnderDays Int
  notificationEmail            String

  // §113 Angaben des Arbeitgebers. Die Anschrift steht nach §108 GewO auf jeder
  // Entgeltabrechnung; Bankverbindung und Betriebsnummer werden fuer die
  // SEPA-Datei und den DATEV-Export gebraucht.
  strasse                      String?
  plz                          String?
  ort                          String?
  betriebsnummer               String?   // Agentur fuer Arbeit, 8-stellig
  steuernummer                 String?
  iban                         String?
  bic                          String?
  kontoinhaber                 String?
  datevBeraternummer           String?
  datevMandantennummer         String?

  // §147 Ob die Standortleitung BEM-Vorgaenge sehen darf.
  //
  // Standardmaessig NEIN: Es sind Gesundheitsdaten nach Art. 9 DSGVO, und der
  // Kreis der Mitwissenden gehoert so klein wie moeglich gehalten. In kleinen
  // Betrieben fuehrt die Standortleitung das Gespraech aber selbst — dann
  // laesst sich das hier einschalten.
  bemSichtbarLeitung           Boolean  @default(false)

  // §130 Ab dem wievielten Kalendertag der Betrieb die
  // Arbeitsunfaehigkeitsbescheinigung verlangt.
  //
  // §5 Abs.1 EntgFG sagt: spaetestens ab dem vierten. Satz 3 erlaubt dem
  // Arbeitgeber, sie frueher zu verlangen — das steht dann im Arbeitsvertrag.
  // Deshalb einstellbar und nicht einprogrammiert. Leer = die gesetzlichen
  // vier Tage.
  auNachweisAbTag              Int?

  // §148 Die Karriereseite.
  //
  // Sie ist die einzige Seite dieses Programms, die ohne Anmeldung erreichbar
  // ist. Deshalb steht hier auch das Impressum: Eine oeffentliche Seite eines
  // Unternehmens ohne Anbieterkennzeichnung ist nach §5 DDG abmahnfaehig, und
  // das waere ein unschoener Weg, eine neue Funktion kennenzulernen. Ohne
  // Impressum geht die Seite gar nicht erst online.
  karriereSlug                 String?  @unique
  karriereAktiv                Boolean  @default(false)
  karriereUeberschrift         String?
  karriereText                 String?
  /// Wohin eine eingegangene Bewerbung gemeldet wird. Leer = notificationEmail
  karriereEmail                String?
  karriereImpressum            String?
  karriereDatenschutz          String?

  updatedAt                    DateTime @updatedAt
}

