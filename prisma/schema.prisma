// ── Bug Reports ───────────────────────────────────────────────────────────────

model BugReport {
  id            String   @id @default(cuid())
  ticketId      String   @unique
  status        String   @default("open")
  priority      String   @default("normal")
  severity      String   @default("normal")
  userId        String?
  userName      String?
  userRole      String?
  customerId    String?
  customerName  String?
  title         String   @default("")
  description   String?
  page          String?
  browser       String?
  os            String?
  screenSize    String?
  consoleErrors String?
  lastActions   String?
  adminNotes    String?

  // §133 Aus dem Fehlermelder wird die Fundstelle.
  //
  // Bisher waren Titel, Beschreibung und Schwere alles. Damit laesst sich ein
  // Fund nicht nachstellen und schon gar nicht automatisch beheben — es fehlt
  // genau die eine Angabe, an der alles haengt: was der Melder erwartet hat.

  /// fehler | verbesserung | frage | wunsch
  art            String   @default("fehler")
  /// dienstplan | zeit | urlaub | lohn | nachrichten | akte | datenschutz | einrichtung | sonstiges
  bereich        String   @default("sonstiges")
  /// In welcher Rolle getestet wurde — nicht zwingend die Rolle des Zugangs
  ebene          String?
  /// Was hast du getan
  schritte       String?
  /// Was haettest du erwartet — das wichtigste Feld
  erwartet       String?
  /// immer | manchmal | einmal
  haeufigkeit    String?
  /// Beruehrt Geld oder Recht: Lohn, Arbeitszeiten, Loeschfristen, Zugriffsrechte.
  /// Hebt die Dringlichkeit und sperrt jede automatische Behebung.
  heikel         Boolean  @default(false)
  /// Build-Nummer, in der der Fund auftrat
  version        String?
  /// gruen | gelb — ob die Meldung zum Arbeiten reicht, beim Speichern bestimmt
  meldeQualitaet String   @default("gelb")

  // Freigabe — Verbesserungen und Wuensche werden nie ohne Zustimmung gebaut
  /// offen | freigegeben | abgelehnt
  freigabe       String?
  freigabeVon    String?
  freigabeAm     DateTime?
  freigabeNotiz  String?

  // Rueckfrage, wenn die Meldung nicht reicht
  rueckfrage     String?
  antwort        String?

  /// Der vorgeschlagene Behebungsweg
  vorschlag      String?
  erledigtAm     DateTime?
  erledigtNotiz  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([art, bereich])
}

/// §147 Betriebliches Eingliederungsmanagement (§167 Abs. 2 SGB IX).
///
/// Wer innerhalb eines Jahres laenger als sechs Wochen arbeitsunfaehig war,
/// dem MUSS ein BEM angeboten werden. Die Schwelle rechnet das System aus den
/// Fehlzeiten selbst aus; dieser Eintrag haelt fest, was daraufhin geschah.
///
/// DIESE DATEN SIND BESONDERS. Gesundheitsdaten nach Art. 9 DSGVO. Deshalb
/// steht hier NUR, was im Verfahren geschah — niemals eine Diagnose. Und
/// deshalb ist die Sichtbarkeit standardmaessig auf die Unternehmensebene
/// beschraenkt.
///
/// Eine Ablehnung wird festgehalten und nicht geloescht: Sie ist der Nachweis,
/// dass angeboten wurde, und damit das Wertvollste am ganzen Vorgang.
model BemVorgang {
  id              String    @id @default(cuid())
  employeeId      String
  customerId      String
  /// Wie viele AU-Tage im rollenden Jahr die Schwelle ausgeloest haben
  tageBeiAusloesung Int     @default(0)
  ausgeloestAm    DateTime  @default(now())

  angebotenAm     DateTime?
  angebotenVon    String?
  /// offen | zugestimmt | abgelehnt — die Teilnahme ist freiwillig
  antwort         String    @default("offen")
  antwortAm       DateTime?

  /// Was herausgekommen ist. Ohne Ergebnis waere das Verfahren nicht
  /// durchgefuehrt, sondern nur abgehakt — und genau das prueft ein
  /// Arbeitsgericht spaeter.
  ergebnis        String?
  abgeschlossenAm DateTime?
  abgeschlossenVon String?

  notiz           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([employeeId])
  @@index([customerId])
}

/// §146 Eine Art von Nachweis oder Frist, die ein Kunde fuehrt.
///
/// Der Katalog gehoert dem Kunden. Wir liefern Vorlagen je Betriebsform mit
/// (src/lib/nachweis-vorlagen.ts), aber nichts davon ist einprogrammiert: Ein
/// Betrieb, der nur ein Fuehrungszeugnis fuehrt, legt genau einen Eintrag an.
///
/// Erste Hilfe, Hygienebelehrung, Masernnachweis, Probezeitende, auslaufende
/// Befristung — das sieht nach vielen Themen aus und ist eines: ein Datum
/// laeuft ab, und jemand muss es vorher wissen.
model Nachweisart {
  id             String   @id @default(cuid())
  customerId     String
  name           String
  /// nachweis | vertrag — nur fuer die Gruppierung in der Anzeige
  gattung        String   @default("nachweis")
  /// alle | positionen | qualifikationen | einzeln
  giltFuer       String   @default("alle")
  /// Bei positionen/qualifikationen: die Werte, auf die es zutrifft
  giltFuerWerte  String[] @default([])
  /// einmalig | einstellung | wiederkehrend | einstellung_und_wiederkehrend
  faelligkeit    String   @default("wiederkehrend")
  /// Bei wiederkehrend: der Abstand in Monaten
  abstandMonate  Int?
  /// Wie viele Tage vorher gewarnt wird
  vorwarnTage    Int      @default(56)
  nachweisNoetig Boolean  @default(true)
  /// leitung | unternehmen — was die Leitung nicht sehen darf, wird
  /// ausgeblendet, nicht ausgegraut
  sichtbarkeit   String   @default("leitung")
  /// warnen | sperren — sperren heisst: ohne gueltigen Nachweis nicht einplanen
  folge          String   @default("warnen")
  /// Die Vorschrift, aus der die Frist folgt. Wer sie aendert, soll sehen,
  /// woran er ruettelt.
  grundlage      String?
  aktiv          Boolean  @default(true)
  reihenfolge    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([customerId])
}

/// §146 Der Stand einer Frist bei einer Person.
///
/// Gespeichert werden nur Tatsachen: wann erfuellt, bis wann gueltig, ob
/// befreit. Der STAND ("laeuft ab", "abgelaufen") wird gerechnet — ein
/// gespeicherter Status waere am naechsten Morgen falsch, ohne dass jemand
/// etwas getan haette.
model Frist {
  id            String    @id @default(cuid())
  employeeId    String
  customerId    String
  /// Die Art aus dem Katalog. Leer bei einer von Hand angelegten Einzelfrist —
  /// die wird beim Abgleich nie weggeraeumt.
  nachweisartId String?
  /// Kopie des Namens, damit der Eintrag lesbar bleibt, wenn die Art umbenannt
  /// oder geloescht wird
  bezeichnung   String
  gattung       String    @default("nachweis")
  /// Wann zuletzt erfuellt: Schulung besucht, Untersuchung gemacht, unterschrieben
  erfuelltAm    DateTime?
  /// Bis wann es gilt — das Feld, um das sich alles dreht
  faelligAm     DateTime?
  /// Wer befreit ist, braucht einen Grund. Sonst ist es keine Befreiung,
  /// sondern Vergessen.
  befreitAm     DateTime?
  befreitGrund  String?
  /// Das hinterlegte Dokument in der Personalakte
  dateiId       String?
  notiz         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, nachweisartId])
  @@index([employeeId])
  @@index([customerId, faelligAm])
}

/// §142 Stufe 3: Was der Lauf selbst behoben hat.
///
/// Jede automatische Aenderung an einem Programm, das Gehaelter rechnet, muss
/// nachher erklaerbar sein — was wurde geaendert, warum, welche Dateien, was
/// hat es geprueft, und auf welchem Weg ist es rausgegangen. Ohne diese Spur
/// waere die Automatik nicht zu verantworten: Man kann nicht zurueckdrehen,
/// was man nicht sieht.
///
/// Die Entscheidung "direkt" oder "sammeln" faellt NICHT hier und nicht im
/// Lauf, sondern in src/lib/behebung.ts anhand der geaenderten Dateien.
model Behebung {
  id          String   @id @default(cuid())
  /// Der Fund, um den es geht
  fundId      String
  /// Seine Kennung, damit der Eintrag auch ohne Verknuepfung lesbar bleibt
  kennung     String?
  titel       String   @default("")

  /// anzeige | logik — was der Lauf ueber seine Aenderung sagt
  klasse      String
  /// direkt | sammeln | abgelehnt — was das Programm daraus gemacht hat
  ausgang     String
  /// Der Satz, der auf der Fundeseite steht
  grund       String   @default("")

  /// Die geaenderten Dateien
  dateien     Json
  zeilen      Int      @default(0)
  /// Was der Lauf zu seiner Aenderung sagt — fuenf Saetze
  begruendung String?

  /// Ergebnis der Pruefreihe: Nachweise, Modultests, Build
  pruefstand  Json?

  /// Wohin gepusht wurde
  zweig       String?
  commit      String?

  /// ausgerollt | wartet | freigegeben | verworfen
  status      String   @default("wartet")
  entschiedenVon String?
  entschiedenAm  DateTime?
  entscheidNotiz String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fundId])
  @@index([status])
}

// ── Timesheet Approvals ───────────────────────────────────────────────────────

model TimesheetApproval {
  id              String   @id @default(cuid())
  employeeId      String
  employeeName    String?
  locationId      String?
  year            Int
  month           Int
  status          String   @default("pending")
  approvedBy      String?
  approvedAt      String?
  rejectionReason String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, year, month])
}

// ── Payroll Entries ───────────────────────────────────────────────────────────

/// §120 Eine Einmalzahlung: Weihnachtsgeld, Urlaubsgeld, Praemie, Abfindung.
///
/// Sonstige Bezuege werden anders besteuert als laufender Lohn — nach der
/// Jahreslohnsteuer-Methode (§39b Abs.3 EStG): die Steuer ist der Unterschied
/// zwischen der Steuer auf den Jahreslohn MIT und OHNE die Zahlung. In der
/// Sozialversicherung gilt die anteilige Jahres-Beitragsbemessungsgrenze
/// statt der monatlichen.
///
/// Deshalb eine eigene Tabelle: eine Einmalzahlung ist ein Ereignis mit
/// eigenem Grund und eigenem Datum, kein Feld an der Monatsabrechnung. In
/// einem Monat koennen mehrere zusammenkommen.
model PayrollBonus {
  id           String   @id @default(cuid())
  employeeId   String
  employeeName String?
  customerId   String
  locationId   String?
  jahr         Int
  monat        Int
  /// weihnachtsgeld | urlaubsgeld | praemie | abfindung | sonstiges
  art          String
  bezeichnung  String
  betrag       Float
  /// Abfindungen sind beitragsfrei und werden nach der Fuenftelregelung
  /// besteuert — deshalb eigens gekennzeichnet.
  beitragsfrei Boolean  @default(false)
  notiz        String?
  erstelltAm   DateTime @default(now())
  erstelltVon  String?

  @@index([customerId, jahr, monat])
  @@index([employeeId, jahr])
}

/// §119 Eine rueckwirkende Aenderung an einem bereits freigegebenen Monat.
///
/// Zwei Prinzipien treffen hier aufeinander und werden bewusst unterschiedlich
/// behandelt:
///   - Lohnsteuer folgt dem Zuflussprinzip: die Differenz wird in dem Monat
///     versteuert, in dem sie ausgezahlt wird (§41c EStG erlaubt dem
///     Arbeitgeber die Aufrollung innerhalb des Jahres).
///   - Sozialversicherung folgt beim laufenden Entgelt dem Entstehungsprinzip:
///     die Beitraege gehoeren in den URSPRUNGSMONAT. Deshalb bleiben jahr und
///     monat hier der korrigierte Monat, waehrend ausgleichJahr/-monat sagen,
///     wann das Geld fliesst.
model PayrollCorrection {
  id             String   @id @default(cuid())
  employeeId     String
  employeeName   String?
  customerId     String
  locationId     String?
  /// Der Monat, der neu gerechnet wurde
  jahr           Int
  monat          Int
  /// Der Monat, in dem die Differenz ausgezahlt wird
  ausgleichJahr  Int
  ausgleichMonat Int
  grund          String
  /// Vollstaendige Momentaufnahmen — fuer den Beitragsnachweis wird spaeter
  /// mehr gebraucht als nur die Differenz.
  werteAlt       Json
  werteNeu       Json
  /// Die Zahlen, nach denen tatsaechlich gehandelt wird
  differenzBrutto     Float
  differenzNetto      Float
  differenzLohnsteuer Float
  differenzSvAN       Float
  differenzSvAG       Float
  status         String   @default("offen") // offen | ausgeglichen | verworfen
  ausgeglichenIn String?
  erstelltAm     DateTime @default(now())
  erstelltVon    String?

  @@index([customerId, ausgleichJahr, ausgleichMonat])
  @@index([employeeId, jahr, monat])
}

model PayrollEntry {
  id              String   @id @default(cuid())
  employeeId      String
  employeeName    String?
  locationId      String?
  customerId      String
  year            Int
  month           Int
  status          String   @default("draft")
  // Wage
  hourlyWage      Float?
  monthlyWage     Float?
  // Labour hours
  regularHours    Float    @default(0)
  overtimeHours   Float    @default(0)
  nightHours      Float    @default(0)
  sundayHours     Float    @default(0)
  holidayHours    Float    @default(0)
  saturdayHours   Float    @default(0)
  vacationDays    Int      @default(0)
  sickDays        Int      @default(0)
  // Tax & insurance
  taxClass        Int      @default(1)
  childCount      Float    @default(0)
  insuranceType   String   @default("GKV")
  pkv             Float?
  churchTax       Boolean  @default(false)
  bundesland      String?
  // Calculated results
  brutto          Float    @default(0)
  surchargesTotal Float    @default(0)
  // §3b EStG: steuer- und beitragsfreier Anteil der Zuschläge
  steuerfreieZuschlaege Float @default(0)
  svfreieZuschlaege     Float @default(0)
  steuerBrutto          Float @default(0)
  svBrutto              Float @default(0)
  lohnsteuer      Float    @default(0)
  kirchensteuer   Float    @default(0)
  soli            Float    @default(0)
  rvAN            Float    @default(0)
  kvAN            Float    @default(0)
  pvAN            Float    @default(0)
  avAN            Float    @default(0)
  totalDeductions Float    @default(0)
  netto           Float    @default(0)
  rvAG            Float    @default(0)
  kvAG            Float    @default(0)
  pvAG            Float    @default(0)
  avAG            Float    @default(0)
  totalAgCost     Float    @default(0)
  // §116 Nach welchem Stand gerechnet wurde — steht auch auf dem Beleg
  grundlage       String?
  // §121 Welche Beschaeftigungsart tatsaechlich galt, und die Pauschsteuer des
  // Arbeitgebers beim Minijob — sie ist kein Abzug beim Arbeitnehmer.
  beschaeftigungsart String @default("regulaer")
  pauschsteuerAG     Float  @default(0)
  // §122 SV-Tage des Monats — 30 heisst voller Monat. Steht am Eintrag, weil
  // spaeter niemand mehr rekonstruieren kann, mit welchem Anteil gerechnet wurde.
  svTage             Int    @default(30)
  // §119 Aufrollung: Differenzen aus rueckwirkend geaenderten Monaten werden
  // hier ausgeglichen. auszahlungsbetrag ist das, was wirklich ueberwiesen
  // wird — Netto plus Korrektur. SEPA, DATEV und der Beleg lesen dieses eine
  // Feld, damit sie nicht auseinanderlaufen koennen.
  korrekturNetto  Float    @default(0)
  auszahlungsbetrag Float  @default(0)
  // §120 Einmalzahlungen des Monats und die Steuer darauf. Sie werden getrennt
  // ausgewiesen, weil sie getrennt berechnet werden — und weil der
  // Steuerberater sie getrennt braucht.
  sonstigeBezuege       Float @default(0)
  lohnsteuerSonstige    Float @default(0)
  kirchensteuerSonstige Float @default(0)
  soliSonstige          Float @default(0)
  svANSonstige          Float @default(0)
  svAGSonstige          Float @default(0)
  // Meta
  approvedBy      String?
  approvedAt      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, year, month])
}

// ── SMS 2FA ───────────────────────────────────────────────────────────────────

model SmsTotpCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
}

// ── Support Tickets ───────────────────────────────────────────────────────────

model SupportTicket {
  id            String                 @id @default(cuid())
  ticketId      String                 @unique
  status        String                 @default("new")
  priority      String                 @default("normal")
  category      String?
  userId        String?
  userName      String?
  userRole      String?
  customerId    String?
  customerName  String?
  locationId    String?
  locationName  String?
  currentPage   String?
  title         String
  description   String?
  browser       String?
  os            String?
  screenSize    String?
  consoleErrors String?
  lastActions   String?
  adminNotes    String?
  assignedTo    String?
  resolvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  messages      SupportTicketMessage[]
  accessGrants  SupportAccessGrant[]
}

model SupportTicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String
  authorRole String
  body       String
  internal   Boolean       @default(false)
  createdAt  DateTime      @default(now())
}

model SupportAccessGrant {
  id         String             @id @default(cuid())
  ticketId   String
  ticket     SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  customerId String
  grantedBy  String
  grantedTo  String?
  scope      String             @default("readonly")
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime           @default(now())
  logs       SupportAccessLog[]
}

model SupportAccessLog {
  id        String             @id @default(cuid())
  grantId   String
  grant     SupportAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  userId    String
  action    String
  resource  String?
  createdAt DateTime           @default(now())
}

// ── Admin Audit Log ────────────────────────────────────────────────────────────

model AdminAuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  entityName String?
  actorId    String
  actorName  String?
  details    String?
  createdAt  DateTime @default(now())
}

// ── Planning Policy (Phase 9) ─────────────────────────────────────────────────
// Human-readable admin configuration that governs how the solver run is evaluated.
// One record per location; upserted by PUT /api/planning-policy.

model PlanningPolicy {
  locationId              String    @id
  customerId              String
  // How to treat employees with excess hours before the planning run
  defaultOvertimeHandling String    @default("normal") // reduce | normal | compensate
  // Minimum quality score required for automatic approval (0–100)
  minAutoApproveScore     Float     @default(80)
  // Abort the run immediately when the solver reports INFEASIBLE (vs. partial plan)
  failFastOnInfeasible    Boolean   @default(true)
  // Deadline by which employees must submit their wishes; after this the scheduler locks input
  requestDeadline         DateTime?
  updatedAt               DateTime  @updatedAt

  @@index([customerId])
}

// ── Employee Requests (Phase 8) ──────────────────────────────────────────────
// Structured employee requests: single source of truth for all request types.
// Complements WishSubmission (per-date soft wishes) with a richer model that
// covers vacations, absences, overtime adjustments and date-range requests.

model EmployeeRequest {
  id          String    @id @default(cuid())
  employeeId  String
  locationId  String
  customerId  String
  // Type of request (mirrors EmployeeRequestType in company-model-types.ts)
  type        String // shift_wish | day_off_wish | vacation | absence | overtime_reduce | overtime_compensate
  status      String    @default("pending") // pending | approved | rejected | expired
  priority    String    @default("normal") // low | normal | high | critical
  // Day-specific requests
  date        String?
  // Range requests (vacation, absence, consecutive days off)
  dateFrom    String?
  dateTo      String?
  // For shift_wish: which shift
  shiftId     String?
  reason      String?
  // Audit
  submittedAt DateTime  @default(now())
  respondedAt DateTime?
  respondedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId])
  @@index([locationId])
  @@index([customerId])
}

// ── §31 ShiftDemand — configurable per-shift staffing targets ────────────────

model ShiftDemand {
  id         String   @id @default(cuid())
  locationId String
  shiftId    String
  date       String? // null = recurring rule
  dayOfWeek  Int? // 0=Sun…6=Sat; null = all days
  minStaff   Int      @default(1)
  maxStaff   Int?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([locationId])
}

// ── §62 PlanChange — dispatcher learning: track manual plan edits ──────────────

model PlanChange {
  id         String   @id @default(cuid())
  locationId String
  customerId String
  sessionId  String? // planning session that generated the original plan
  employeeId String
  date       String
  oldShiftId String?
  newShiftId String?
  changeType String // assign | remove | swap
  changedBy  String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([locationId])
  @@index([employeeId])
}

// ── Workflow Engine — Requirement Learning Queue ───────────────────────────────

model WorkflowLearning {
  id             String   @id @default(cuid())
  workflowId     String
  customerId     String?
  locationId     String?
  type           String
  description    String
  confidence     String
  structuredData Json?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
}

// ── §70 Custom Constraint Generator ──────────────────────────────────────────

model CustomConstraint {
  id          String   @id @default(cuid())
  locationId  String
  customerId  String
  name        String
  description String
  code        String
  status      String   @default("pending")
  errorLog    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locationId])
  @@index([customerId])
}

// ── §100 Dateiablage ─────────────────────────────────────────────────────────
// Fundament für Personalakte, Krankenscheine und Lohnbelege. Bis hierher gab es
// im System überhaupt keine Möglichkeit, eine Datei abzulegen.
//
// Der Inhalt liegt standardmäßig in der Datenbank (Treiber "db"): Personalakten
// sind klein, und der Dateispeicher von Railway ist nach jedem Neustart leer —
// für Arbeitsverträge untauglich. Für größere Mengen kann später ein
// S3-kompatibler Speicher dazukommen, ohne dass sich am Rest etwas ändert.

model StoredFile {
  id         String  @id @default(cuid())
  customerId String
  locationId String?

  // Wem gehört die Datei: "employee" oder "location"
  ownerType String
  ownerId   String

  // vertrag | zeugnis | bescheinigung | krankenschein | lohnabrechnung | sonstiges
  kategorie String @default("sonstiges")

  dateiname String
  mimeType  String
  groesse   Int

  // Treiber "db": Inhalt hier. Treiber "s3": Schlüssel im Objektspeicher.
  treiber          String  @default("db")
  inhalt           Bytes?
  objektSchluessel String?

  // Steuert, ob der Mitarbeiter die Datei in seiner App sieht.
  // Lohnabrechnung und Vertrag: ja. Interne Notizen: nein.
  sichtbarFuerMitarbeiter Boolean @default(false)

  hochgeladenVon     String
  hochgeladenVonName String?
  notiz              String?
  gueltigVon         String?
  gueltigBis         String?

  createdAt DateTime  @default(now())
  // Weiches Löschen: Personalunterlagen unterliegen Aufbewahrungsfristen,
  // ein sofortiges Verschwinden wäre in vielen Fällen unzulässig.
  deletedAt DateTime?

  // §130 Zu welcher Fehlzeit dieser Nachweis gehoert.
  //
  // Eine Fehlzeit kann mehrere haben: Erst- und Folgebescheinigung sind der
  // Normalfall, nicht die Ausnahme. Deshalb haengt die Verbindung an der Datei
  // und nicht an der Abwesenheit.
  absenceId String?

  @@index([absenceId])
  @@index([ownerType, ownerId])
  @@index([customerId])
  @@index([locationId])
}

// ── §102 Lohn-Stammdaten am Mitarbeiter ──────────────────────────────────────
// PayrollEntry verlangt Steuerklasse, Kinderfreibetraege, Versicherungsart,
// Kirchensteuer, Bundesland und Lohn — beim Mitarbeiter stand davon nichts.
// Jede Abrechnung haette diese Angaben neu gebraucht.
//
// Bewusst eine eigene Tabelle: Bankverbindung, Sozialversicherungs- und
// Steuernummer sind besonders schutzwuerdig und haben nichts in derselben
// Zeile wie der Anzeigename zu suchen. Nur Leitung, Unternehmen und der
// Mitarbeiter selbst kommen heran.

model EmployeePayrollProfile {
  employeeId          String   @id
  customerId          String?

  // Zuordnung im Betrieb
  personalnummer      String?
  eintrittsdatum      String?
  austrittsdatum      String?
  befristetBis        String?
  probezeitBis        String?

  // Anschrift — steht auf jeder Lohnabrechnung
  strasse             String?
  plz                 String?
  ort                 String?

  // Steuer
  steuerId            String?   // Steuerliche Identifikationsnummer (11-stellig)
  steuerklasse        Int?      // 1–6
  kinderfreibetraege  Float?    // z.B. 0, 0.5, 1, 1.5 …
  konfession          String?   // keine | ev | rk | sonstige
  bundesland          String?   // Kirchensteuersatz und Feiertage

  // Sozialversicherung
  sozialversicherungsnummer String?
  versicherungsart    String?   // GKV | PKV
  krankenkasse        String?
  zusatzbeitrag       Float?    // Prozentpunkte der Krankenkasse
  pkvBeitrag          Float?    // Monatsbeitrag bei privater Versicherung
  rentenversicherungspflichtig Boolean @default(true)
  schwerbehindert     Boolean   @default(false)
  // §121 Beschaeftigungsart: regulaer | minijob | kurzfristig.
  // Der Uebergangsbereich wird NICHT hier gefuehrt — er ergibt sich aus dem
  // Entgelt und ist keine Vereinbarung, sondern Gesetz.
  beschaeftigungsart  String?
  /// Minijob: Befreiung von der Rentenversicherungspflicht auf Antrag
  rvBefreiung         Boolean?
  /// Minijob: 2 % Pauschsteuer statt individueller Besteuerung nach ELStAM
  pauschalsteuer      Boolean?

  // §116 Pflegeversicherung: der Zuschlag entfaellt dauerhaft mit dem ersten Kind,
  // die Abschlaege gibt es nur fuer Kinder unter 25 und erst ab dem zweiten.
  hatKinder           Boolean?
  kinderUnter25       Int?

  // §117 ELStAM — die Merkmale, nach denen die Lohnsteuer gerechnet wird.
  // Sie gehoeren dem Finanzamt, nicht uns: wir fuehren nur nach, was in der
  // Aenderungsliste des Arbeitgebers steht. elstamStand sagt, von wann dieser
  // Stand ist; ohne ihn wird vor jedem Abrechnungslauf gewarnt.
  elstamStand         String?   // YYYY-MM-DD der zugrunde liegenden Liste
  elstamQuelle        String?   // z.B. "Aenderungsliste 03/2026" oder "manuell"
  elstamBestaetigtVon String?
  freibetragMonat     Float?    // Freibetrag lt. ELStAM, Monatsbetrag
  hinzurechnungMonat  Float?    // Hinzurechnungsbetrag lt. ELStAM, Monatsbetrag
  faktor              Float?    // Faktorverfahren, nur Steuerklasse IV

  // Entgelt
  lohnart             String?   // stunde | monat
  stundenlohn         Float?
  monatsgehalt        Float?

  // Zahlung — Grundlage fuer die spaetere SEPA-Datei
  iban                String?
  bic                 String?
  kontoinhaber        String?

  notiz               String?
  updatedAt           DateTime @updatedAt

  @@index([customerId])
}

// ─── §148 Recruiting: Stellen, Karriereseite, Bewerber ───────────────────────

/// §148 Eine ausgeschriebene Stelle.
///
/// WARUM DIE ANZEIGE IN FELDERN STEHT UND NICHT ALS EIN TEXTBLOCK
/// Eine Stellenanzeige geht nicht nur auf die eigene Karriereseite. Google for
/// Jobs will strukturierte Angaben (Ort, Umfang, Verguetung, Datum), und jede
/// Boerse will sie wieder anders. Aus Feldern laesst sich jedes Format bauen;
/// aus einem fertigen Absatz laesst sich nichts mehr herausholen.
///
/// WARUM DER TEXT TROTZDEM FREI BLEIBT
/// `beschreibung` ist der Teil, den der Betrieb selbst schreibt. Ein Programm,
/// das eine Kita zwingt, ihre Stelle in dieselben Stichpunkte zu pressen wie
/// ein Pflegedienst, produziert Anzeigen, die niemand liest.
model Stelle {
  id                String    @id @default(cuid())
  customerId        String
  /// Leer = unternehmensweit ausgeschrieben
  locationId        String?
  titel             String
  /// Der Ort in der Anzeige. Kopiert und nicht nachgeschlagen, damit eine
  /// veroeffentlichte Anzeige sich nicht aendert, wenn jemand den Standort
  /// umbenennt.
  ort               String?
  plz               String?
  /// vollzeit | teilzeit | minijob | ausbildung | praktikum | aushilfe
  umfang            String    @default("vollzeit")
  stundenProWoche   Int?
  /// unbefristet | befristet
  befristung        String    @default("unbefristet")
  befristetBis      String?
  /// Leer heisst "ab sofort"
  beginn            String?
  beschreibung      String    @default("")
  aufgaben          String[]  @default([])
  profil            String[]  @default([])
  wirBieten         String[]  @default([])
  /// Angaben zur Verguetung. Freiwillig — aber eine Anzeige ohne Zahl wird
  /// deutlich seltener angeklickt.
  verguetungVon     Int?
  verguetungBis     Int?
  /// stunde | monat | jahr
  verguetungZeit    String    @default("monat")
  /// entwurf | veroeffentlicht | geschlossen
  status            String    @default("entwurf")
  /// Die Adresse der Anzeige auf der Karriereseite
  slug              String
  veroeffentlichtAm DateTime?
  geschlossenAm     DateTime?
  kontaktName       String?
  kontaktEmail      String?
  erstelltVon       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([customerId, slug])
  @@index([customerId, status])
  @@index([locationId])
}

/// §148 Eine Bewerbung — ueber die Karriereseite eingegangen oder von Hand
/// eingepflegt.
///
/// WARUM `employeeId` HIER STEHT
/// Weil eine Bewerbung im besten Fall in einer Einstellung endet. Ohne diese
/// Verbindung waere nach der Uebernahme nicht mehr erkennbar, woher jemand
/// kam — und die Bewerbungsdaten wuerden nach der Loeschfrist entfernt,
/// obwohl die Person inzwischen im Haus arbeitet.
///
/// WARUM `loeschenAb` EIN FELD IST UND KEINE RECHNUNG
/// Bewerberdaten duerfen nicht unbegrenzt liegen bleiben. Die Frist haengt
/// aber vom Verlauf ab: Eine Absage startet sie, eine Aufnahme in den
/// Bewerberpool mit Einwilligung verlaengert sie. Ein gerechneter Wert waere
/// nach der ersten Einwilligung falsch.
model Bewerbung {
  id            String    @id @default(cuid())
  customerId    String
  stelleId      String?
  /// Kopie des Titels, damit die Bewerbung lesbar bleibt, wenn die Anzeige
  /// laengst geschlossen und geloescht ist
  stelleTitel   String?
  locationId    String?
  name          String
  email         String
  telefon       String?
  nachricht     String?
  /// karriereseite | eingepflegt | empfehlung | initiativ | boerse
  quelle        String    @default("karriereseite")
  /// neu | gesichtet | gespraech | zusage | absage | eingestellt
  status        String    @default("neu")
  /// Wann der Stand zuletzt bewegt wurde
  statusAm      DateTime  @default(now())
  gespraechAm   DateTime?
  gespraechOrt  String?
  notiz         String?
  /// Einwilligung, die Unterlagen ueber die gesetzliche Frist hinaus zu
  /// behalten. Ohne sie wird nach `loeschenAb` geloescht.
  poolBis       DateTime?
  employeeId    String?
  uebernommenAm DateTime?
  /// §128 Ab wann die Daten zu loeschen sind
  loeschenAb    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([customerId, status])
  @@index([stelleId])
  @@index([loeschenAb])
  @@index([employeeId])
}

/// §148 Was mit einer Bewerbung geschehen ist.
///
/// Der Grund ist dasselbe wie beim Loeschbericht: Wer absagt, muss spaeter
/// belegen koennen, wann und warum — das AGG kennt eine Klagefrist von zwei
/// Monaten, und in dieser Zeit ist eine luecklose Spur der einzige Schutz.
/// Zugleich ist es das, was ein Bewerber-CRM ueberhaupt brauchbar macht: Man
/// sieht auf einen Blick, wer wann mit wem gesprochen hat.
model BewerbungEreignis {
  id          String   @id @default(cuid())
  bewerbungId String
  /// eingegangen | stand | notiz | nachricht | einladung | uebernahme
  art         String
  text        String
  vonName     String?
  createdAt   DateTime @default(now())

  @@index([bewerbungId, createdAt])
}

// ─── §149 Nachweise anfordern — mit Rückweg ──────────────────────────────────

/// §149 Eine Aufforderung an einen Menschen, etwas einzureichen.
///
/// WARUM DAS NICHT EINFACH EINE NACHRICHT IST
/// Weil eine Nachricht keinen Zustand hat. „Bitte reich dein Fuehrungszeugnis
/// ein" im Chat ist nach drei Tagen weggescrollt, und niemand weiss mehr, wer
/// geantwortet hat und wer nicht. Hier ist es ein Vorgang: Er ist offen,
/// eingereicht, in Rueckfrage oder erledigt — und eine Liste zeigt jederzeit,
/// bei wem er noch offen steht.
///
/// WARUM DIE VERBINDUNG ZUR FRIST
/// Weil das Ziel nicht die eingereichte Datei ist, sondern eine gueltige
/// Frist. Wird die Anforderung abgenommen, traegt das System `erfuelltAm` in
/// die Frist ein und der Motor (§146) rechnet das naechste Ablaufdatum selbst
/// aus. Ohne diese Verbindung haette man zwei Wahrheiten: eine eingereichte
/// Bescheinigung und eine Frist, die weiter auf Rot steht.
model Anforderung {
  id                 String    @id @default(cuid())
  customerId         String
  employeeId         String
  locationId         String?
  /// Die Frist, die damit erfuellt werden soll. Leer bei einer freien
  /// Anforderung ("bitte reich deine neue Bankverbindung ein").
  fristId            String?
  nachweisartId      String?
  titel              String
  /// Was genau gebraucht wird, in eigenen Worten
  hinweis            String?
  /// Bis wann eingereicht werden soll
  fristBis           DateTime?
  /// offen | eingereicht | rueckfrage | erledigt | zurueckgezogen
  status             String    @default("offen")
  statusAm           DateTime  @default(now())
  angefordertVon     String?
  angefordertVonName String?
  eingereichtAm      DateTime?
  erledigtAm         DateTime?
  erledigtVon        String?
  /// Wann zuletzt erinnert wurde — damit nicht taeglich gemahnt wird
  erinnertAm         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([customerId, status])
  @@index([employeeId, status])
  @@index([fristId])
}

/// §149 Das Gespraech an der Anforderung.
///
/// Hierher gehoert die Rueckfrage („Das Zeugnis ist aelter als drei Monate,
/// bitte ein neues") und die Antwort darauf. Bewusst am Vorgang und nicht im
/// Chat: Wer in einem halben Jahr wissen will, warum etwas zweimal eingereicht
/// wurde, findet es hier — und nicht in einem Gespraechsverlauf zwischen zwei
/// Menschen, von denen einer nicht mehr im Haus ist.
model AnforderungBeitrag {
  id            String   @id @default(cuid())
  anforderungId String
  userId        String
  /// mitarbeiter | betrieb | system
  seite         String
  absenderName  String
  text          String
  /// Die mitgeschickte Datei in der Personalakte
  dateiId       String?
  dateiname     String?
  createdAt     DateTime @default(now())

  @@index([anforderungId, createdAt])
}

// ─── §150 Belehrungen digital ────────────────────────────────────────────────

/// §150 Eine Belehrung, die an alle geht.
///
/// DAS PROBLEM, DAS SIE LOEST
/// In einer Kita liegen jeden Monat vier, fuenf Seiten Belehrungen zur
/// Unterschrift: Hygiene, Brandschutz, Schweigepflicht, Unfallverhuetung. Sie
/// werden an jede Einrichtung geschickt, dort ausgedruckt, herumgereicht,
/// unterschrieben, eingesammelt und abgeheftet. Drei Wochen spaeter weiss
/// niemand mehr, wer fehlt.
///
/// WARUM DAS DOKUMENT NACH DEM VERTEILEN UNVERAENDERLICH IST
/// Weil die Bestaetigung sonst nichts wert waere. Koennte man den Text
/// nachtraeglich austauschen, liesse sich jederzeit behaupten, jemand habe
/// etwas anderes bestaetigt, als er gelesen hat. Ab dem Verteilen ist diese
/// Zeile festgeschrieben; wer etwas aendern will, schliesst sie und verteilt
/// eine neue Runde.
model Belehrung {
  id                String    @id @default(cuid())
  customerId        String
  titel             String
  beschreibung      String?
  /// Das Dokument in der Ablage (StoredFile, ownerType "belehrung")
  dateiId           String?
  dateiname         String?
  /// Fingerabdruck des Dokuments (SHA-256). Er steht in jedem Beleg und macht
  /// nachweisbar, WELCHE Fassung bestaetigt wurde.
  pruefsumme        String?
  /// Der Wortlaut, den die Person bestaetigt. Einstellbar, weil genau dieser
  /// Satz die rechtliche Wirkung traegt — und weil eine Hygienebelehrung
  /// anders lautet als eine Einweisung in eine Maschine.
  bestaetigungstext String
  /// entwurf | verteilt | geschlossen
  status            String    @default("entwurf")
  /// Bis wann bestaetigt werden soll
  fristBis          DateTime?
  /// Nur als Hinweis und fuer die Wiederholung: monatlich | quartal | jaehrlich
  wiederholung      String?
  /// Aus welcher Runde diese hier hervorgegangen ist
  vorlageVon        String?
  /// Ob der Empfaenger das Dokument geoeffnet haben muss, bevor er
  /// bestaetigen kann. Standardmaessig ja.
  oeffnenNoetig     Boolean   @default(true)
  verteiltAm        DateTime?
  geschlossenAm     DateTime?
  erstelltVon       String?
  erstelltVonName   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([customerId, status])
}

/// §150 Der Beleg einer einzelnen Person.
///
/// WARUM HIER KOPIEN STEHEN UND KEINE VERWEISE
/// `personName`, `wortlaut` und `pruefsumme` sind Kopien aus dem Zeitpunkt des
/// Klicks. Ein Beleg, der auf die heutige Fassung verweist, belegt nichts: Er
/// saehe nach einer Aenderung so aus, als haette die Person etwas bestaetigt,
/// das es damals gar nicht gab. Ein Nachweis muss aus sich heraus lesbar sein.
///
/// WAS „GELESEN" HIER HEISST
/// Niemand kann pruefen, ob ein Mensch etwas gelesen hat — auch auf Papier
/// nicht. Festgehalten wird, was sich feststellen laesst: wann das Dokument
/// geoeffnet wurde und wann bestaetigt. Liegt zwischen beidem keine Sekunde,
/// sieht man das im Beleg. Das ist mehr, als eine Unterschriftenliste hergibt.
model BelehrungBestaetigung {
  id           String    @id @default(cuid())
  belehrungId  String
  employeeId   String
  customerId   String
  locationId   String?
  /// Der Name zum Zeitpunkt der Bestaetigung
  personName   String
  /// Der Wortlaut, den diese Person bestaetigt hat
  wortlaut     String?
  /// Der Fingerabdruck des Dokuments, das dabei vorlag
  pruefsumme   String?
  zugestelltAm DateTime  @default(now())
  angesehenAm  DateTime?
  bestaetigtAm DateTime?
  /// Womit bestaetigt wurde — Browser oder App, gekuerzt
  geraet       String?
  erinnertAm   DateTime?

  @@unique([belehrungId, employeeId])
  @@index([employeeId, bestaetigtAm])
  @@index([customerId])
}

/// §152 Ein fehlgeschlagener Anmeldeversuch — die Grundlage der Bremse.
///
/// WARUM EINE EIGENE TABELLE UND NICHT DAS PROTOKOLL
/// Im `AuditLog` steht, WAS geschehen ist, und er wird drei Jahre aufbewahrt
/// (Art. 5 Abs. 2 DSGVO). Hier steht nur, WIE OFT in den letzten Minuten —
/// eine Arbeitszahl, die nach einer Viertelstunde niemanden mehr interessiert.
/// Beides in einer Tabelle hiesse, bei jeder Anmeldung eine wachsende
/// Protokolltabelle zu durchsuchen.
///
/// WAS HIER NICHT STEHT
/// Kein Passwort, auch kein falsches. Und die Adresse nur als gesalzenes
/// Kuerzel: Gebraucht wird die Frage „dieselbe wie eben?", nicht die Adresse
/// selbst. Eine Liste, aus der sich ablesen liesse, wer sich von wo angemeldet
/// hat, soll gar nicht erst entstehen.
model Anmeldeversuch {
  id        String   @id @default(cuid())
  /// konto | adresse
  art       String
  /// Bei `konto` die kleingeschriebene E-Mail, bei `adresse` das Kuerzel
  kennung   String
  createdAt DateTime @default(now())

  @@index([art, kennung, createdAt])
  @@index([createdAt])
}
