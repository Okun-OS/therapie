// ── §100 Dateiablage ─────────────────────────────────────────────────────────
// Fundament für Personalakte, Krankenscheine und Lohnbelege. Bis hierher gab es
// im System überhaupt keine Möglichkeit, eine Datei abzulegen.
//
// Der Inhalt liegt standardmäßig in der Datenbank (Treiber "db"): Personalakten
// sind klein, und der Dateispeicher von Railway ist nach jedem Neustart leer —
// für Arbeitsverträge untauglich. Für größere Mengen kann später ein
// S3-kompatibler Speicher dazukommen, ohne dass sich am Rest etwas ändert.

model StoredFile {
  id         String  @id @default(cuid())
  customerId String
  locationId String?

  // Wem gehört die Datei: "employee" oder "location"
  ownerType String
  ownerId   String

  // vertrag | zeugnis | bescheinigung | krankenschein | lohnabrechnung | sonstiges
  kategorie String @default("sonstiges")

  dateiname String
  mimeType  String
  groesse   Int

  // Treiber "db": Inhalt hier. Treiber "s3": Schlüssel im Objektspeicher.
  treiber          String  @default("db")
  inhalt           Bytes?
  objektSchluessel String?

  // Steuert, ob der Mitarbeiter die Datei in seiner App sieht.
  // Lohnabrechnung und Vertrag: ja. Interne Notizen: nein.
  sichtbarFuerMitarbeiter Boolean @default(false)

  hochgeladenVon     String
  hochgeladenVonName String?
  notiz              String?
  gueltigVon         String?
  gueltigBis         String?

  createdAt DateTime  @default(now())
  // Weiches Löschen: Personalunterlagen unterliegen Aufbewahrungsfristen,
  // ein sofortiges Verschwinden wäre in vielen Fällen unzulässig.
  deletedAt DateTime?

  // §130 Zu welcher Fehlzeit dieser Nachweis gehoert.
  //
  // Eine Fehlzeit kann mehrere haben: Erst- und Folgebescheinigung sind der
  // Normalfall, nicht die Ausnahme. Deshalb haengt die Verbindung an der Datei
  // und nicht an der Abwesenheit.
  absenceId String?

  @@index([absenceId])
  @@index([ownerType, ownerId])
  @@index([customerId])
  @@index([locationId])
}

// ── §102 Lohn-Stammdaten am Mitarbeiter ──────────────────────────────────────
// PayrollEntry verlangt Steuerklasse, Kinderfreibetraege, Versicherungsart,
// Kirchensteuer, Bundesland und Lohn — beim Mitarbeiter stand davon nichts.
// Jede Abrechnung haette diese Angaben neu gebraucht.
//
// Bewusst eine eigene Tabelle: Bankverbindung, Sozialversicherungs- und
// Steuernummer sind besonders schutzwuerdig und haben nichts in derselben
// Zeile wie der Anzeigename zu suchen. Nur Leitung, Unternehmen und der
// Mitarbeiter selbst kommen heran.

model EmployeePayrollProfile {
  employeeId          String   @id
  customerId          String?

  // Zuordnung im Betrieb
  personalnummer      String?
  eintrittsdatum      String?
  austrittsdatum      String?
  befristetBis        String?
  probezeitBis        String?

  // Anschrift — steht auf jeder Lohnabrechnung
  strasse             String?
  plz                 String?
  ort                 String?

  // Steuer
  steuerId            String?   // Steuerliche Identifikationsnummer (11-stellig)
  steuerklasse        Int?      // 1–6
  kinderfreibetraege  Float?    // z.B. 0, 0.5, 1, 1.5 …
  konfession          String?   // keine | ev | rk | sonstige
  bundesland          String?   // Kirchensteuersatz und Feiertage

  // Sozialversicherung
  sozialversicherungsnummer String?
  versicherungsart    String?   // GKV | PKV
  krankenkasse        String?
  zusatzbeitrag       Float?    // Prozentpunkte der Krankenkasse
  pkvBeitrag          Float?    // Monatsbeitrag bei privater Versicherung
  rentenversicherungspflichtig Boolean @default(true)
  schwerbehindert     Boolean   @default(false)
  // §121 Beschaeftigungsart: regulaer | minijob | kurzfristig.
  // Der Uebergangsbereich wird NICHT hier gefuehrt — er ergibt sich aus dem
  // Entgelt und ist keine Vereinbarung, sondern Gesetz.
  beschaeftigungsart  String?
  /// Minijob: Befreiung von der Rentenversicherungspflicht auf Antrag
  rvBefreiung         Boolean?
  /// Minijob: 2 % Pauschsteuer statt individueller Besteuerung nach ELStAM
  pauschalsteuer      Boolean?

  // §116 Pflegeversicherung: der Zuschlag entfaellt dauerhaft mit dem ersten Kind,
  // die Abschlaege gibt es nur fuer Kinder unter 25 und erst ab dem zweiten.
  hatKinder           Boolean?
  kinderUnter25       Int?

  // §117 ELStAM — die Merkmale, nach denen die Lohnsteuer gerechnet wird.
  // Sie gehoeren dem Finanzamt, nicht uns: wir fuehren nur nach, was in der
  // Aenderungsliste des Arbeitgebers steht. elstamStand sagt, von wann dieser
  // Stand ist; ohne ihn wird vor jedem Abrechnungslauf gewarnt.
  elstamStand         String?   // YYYY-MM-DD der zugrunde liegenden Liste
  elstamQuelle        String?   // z.B. "Aenderungsliste 03/2026" oder "manuell"
  elstamBestaetigtVon String?
  freibetragMonat     Float?    // Freibetrag lt. ELStAM, Monatsbetrag
  hinzurechnungMonat  Float?    // Hinzurechnungsbetrag lt. ELStAM, Monatsbetrag
  faktor              Float?    // Faktorverfahren, nur Steuerklasse IV

  // Entgelt
  lohnart             String?   // stunde | monat
  stundenlohn         Float?
  monatsgehalt        Float?

  // Zahlung — Grundlage fuer die spaetere SEPA-Datei
  iban                String?
  bic                 String?
  kontoinhaber        String?

  notiz               String?
  updatedAt           DateTime @updatedAt

  @@index([customerId])
}
