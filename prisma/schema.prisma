// Prisma schema for the new Vertretungsmanagement (substitution management) module.
// Existing app data stays in src/lib/mock-data.ts on purpose – this schema only
// covers the new, persisted module so existing functionality is untouched.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubstitutionStatus {
  open
  filled
  cancelled
  expired
}

enum SubstitutionPriority {
  low
  normal
  high
  urgent
}

enum EscalationStage {
  group
  location
  organization
  springerpool
}

enum CandidateResponseStatus {
  pending
  accepted
  declined
  expired
}

// Additive metadata for an existing mock-data Employee (kept separate from
// mock-data.ts so the existing employee directory is never modified).
model EmployeeProfile {
  employeeId     String   @id
  isSpringer     Boolean  @default(false)
  qualifications String[] @default([])
  groupId        String?
  updatedAt      DateTime @updatedAt
}

// ─── Menschliche Dienstplanung (Modul 8) ────────────────────────────────────
// Voluntary, employee-controlled soft signals for fairer/more human scheduling.
// Kept separate from EmployeeProfile (which serves substitution matching) so
// the two audiences/purposes never get entangled.
model EmployeeHumanContext {
  employeeId          String   @id
  strengths           String[] @default([])
  lifeCircumstances   String[] @default([])
  preferredGroups     String[] @default([])
  preferredActivities String[] @default([])
  shiftPreferences    String[] @default([])
  agreements          String?
  updatedAt           DateTime @updatedAt
}

model EmployeePlanningProfile {
  employeeId         String   @id
  // Schicht-Präferenz für den Solver
  shiftPreference    String   @default("keine") // frueh | spaet | nacht | keine
  // Kinder-Abholzeiten: [{day:"Mo", beforeTime:"15:30"}, ...]
  childPickupTimes   Json     @default("[]")
  // Maximale aufeinanderfolgende Arbeitstage (0 = Unternehmensregel gilt)
  maxConsecutiveDays Int      @default(0)
  // Wochenend-Freiheits-Vereinbarung (z.B. "jedes 2. Wochenende frei")
  weekendRule        String?
  // Zusätzliche Planungsnotiz (dauerhaft, nicht pro Lauf)
  planningNote       String?
  // Zuschlagsregelung
  surchargeMode      String   @default("unternehmensregel") // unternehmensregel | abweichungen | individuell
  surchargeOverrides Json? // nur abweichende Felder vom Unternehmensstandard
  updatedAt          DateTime @updatedAt
}

model SubstitutionRequest {
  id                 String                  @id @default(cuid())
  locationId         String
  groupId            String?
  date               String
  startTime          String
  endTime            String
  // §101 Ausfall aus dem Dienstplan heraus: welcher Dienst ist ausgefallen und
  // wer haette ihn gehabt. Ohne das ist eine Vertretungsanfrage ein loser
  // Zettel ohne Bezug zum Plan.
  scheduleEntryId    String?
  originalEmployeeId String?
  shiftId            String?
  grund              String?
  qualification      String?
  priority           SubstitutionPriority    @default(normal)
  status             SubstitutionStatus      @default(open)
  escalationStage    EscalationStage         @default(group)
  note               String?
  createdBy          String
  createdAt          DateTime                @default(now())
  filledByEmployeeId String?
  filledAt           DateTime?
  candidates         SubstitutionCandidate[]
}

model SubstitutionCandidate {
  id              String                  @id @default(cuid())
  requestId       String
  request         SubstitutionRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  employeeId      String
  employeeName    String
  matchScore      Int
  matchReasons    String[]                @default([])
  escalationStage EscalationStage
  responseStatus  CandidateResponseStatus @default(pending)
  notifiedAt      DateTime?
  respondedAt     DateTime?
  createdAt       DateTime                @default(now())

  @@unique([requestId, employeeId])
}

model PushSubscription {
  id         String   @id @default(cuid())
  employeeId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
}

model Notification {
  id         String   @id @default(cuid())
  employeeId String
  type       String
  title      String
  body       String
  requestId  String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

/// §139 Ein Telefon, das die App aus dem Store nutzt.
///
/// Die Web-Benachrichtigung (PushSubscription) erreicht ein iPhone nur, wenn
/// die Seite auf dem Startbildschirm liegt und der Dienst-Arbeiter lebt. Der
/// native Weg erreicht es auch, wenn die App seit Tagen zu ist — und genau das
/// braucht ein kurzfristiger Ausfall um sechs Uhr morgens.
///
/// Ein Mensch hat mehrere Geraete (Telefon und Tablet), und ein Geraet kann den
/// Besitzer wechseln. Deshalb ist die Kennung eindeutig, nicht die Person: Wer
/// sich neu anmeldet, uebernimmt den Eintrag, statt einen zweiten anzulegen —
/// sonst bekaeme der Vorgaenger weiter die Dienstplaene seines Nachfolgers.
model Geraet {
  id         String   @id @default(cuid())
  employeeId String
  /// Die Geraetekennung von APNs bzw. FCM
  kennung    String   @unique
  /// ios | android
  plattform  String
  erstelltAm DateTime @default(now())
  zuletztAm  DateTime @updatedAt

  @@index([employeeId])
}

/// §139 Der Antrag eines Menschen, seine Daten loeschen zu lassen.
///
/// Zwei Gruende, warum das im Programm steht und nicht in einer E-Mail:
/// Art. 17 DSGVO gibt jedem dieses Recht, und Apple verlangt seit 2022, dass
/// eine App, die ein Konto fuehrt, das Loeschen auch in der App anbietet
/// (Richtlinie 5.1.1 v). Eine Adresse zum Hinschreiben genuegt beidem nicht.
///
/// Geloescht wird dabei NICHT sofort: Lohnunterlagen unterliegen
/// Aufbewahrungsfristen (§147 AO, §257 HGB, §28f SGB IV). Der Antrag geht
/// deshalb an den Arbeitgeber, der ihn mit dem Loeschkonzept (§128) abarbeitet
/// — inklusive der Sperre statt Loeschung, wo das Gesetz sie verlangt.
model Loeschantrag {
  id            String    @id @default(cuid())
  employeeId    String
  customerId    String?
  personName    String
  /// Was die Person dazu geschrieben hat, freiwillig
  begruendung   String?
  /// offen | erledigt | abgelehnt
  status        String    @default("offen")
  /// Was der Arbeitgeber geantwortet hat — bei einer Ablehnung Pflicht
  antwort       String?
  bearbeitetVon String?
  bearbeitetAm  DateTime?
  /// Der Loeschvorgang, mit dem er erledigt wurde
  loeschungId   String?
  createdAt     DateTime  @default(now())

  @@index([employeeId])
  @@index([customerId])
  @@index([status])
}

// ─── Workforce Score (Modul 3: Gamification) ────────────────────────────────
// Additive module. The existing mock-data TimeLog (src/lib/mock-data.ts) stays
// untouched as seed/history data; this model is the new, real persistence
// layer for the clock-in/out action so punctuality can actually be scored.

enum WorkforceLevel {
  bronze
  silber
  gold
  platin
  diamant
}

model TimeClockEntry {
  id         String    @id @default(cuid())
  employeeId String
  date       String
  locationId String
  clockIn    DateTime
  clockOut   DateTime?
  createdAt  DateTime  @default(now())
}

model ScoreEvent {
  id         String   @id @default(cuid())
  employeeId String
  points     Int
  reason     String
  type       String
  relatedId  String?
  createdAt  DateTime @default(now())

  @@unique([type, relatedId])
}

model LevelBonusConfig {
  level     WorkforceLevel @id
  bonusText String?
  updatedAt DateTime       @updatedAt
}

// ─── KI-Onboarding (Modul 02) ────────────────────────────────────────────────
// Zweistufiges Onboarding per KI-Chat statt klassischem Formular.
// Ebene 1 (Träger): trägerweite Angaben, einmalig, ein Datensatz pro Mandant.
// Ebene 2 (Einrichtung): pro Standort (mock-data Location) eigene Konfiguration –
// "Das System darf niemals einfach die Regeln einer anderen Einrichtung kopieren."
// customerId statt fixer 'singleton'-PK: jeder Mandant (Customer) bekommt seinen
// eigenen Datensatz, sonst sehen alle Träger dieselben Onboarding-Daten.
model OrganizationOnboarding {
  customerId              String   @id
  traegerName             String?
  rollenmodell            String?
  unternehmensweiteRegeln String?
  completed               Boolean  @default(false)
  chatMessages            Json?
  updatedAt               DateTime @updatedAt
}

model LocationOnboarding {
  locationId             String   @id
  einrichtungsart        String?
  organisationsstruktur  String?
  personalstruktur       String?
  arbeitszeiten          String?
  dienstplanlogik        String?
  pausenlogik            String?
  wiederkehrendeAufgaben String?
  individuelleRegeln     String[] @default([])
  vertretungsregeln      String?
  urlaubslogik           String?
  zeiterfassung          String?
  besonderheiten         String?
  tagesablauf            String?
  completedPhases        String[] @default([])
  completed              Boolean  @default(false)
  chatMessages           Json?
  updatedAt              DateTime @updatedAt
}

// ─── Google-Kalender-Synchronisation (Modul 04/05/06) ───────────────────────
// Statt einer OAuth-Anbindung (erfordert Google-Cloud-Zugangsdaten, die hier
// nicht vorliegen) nutzen wir einen klassischen, token-basierten ICS-Feed:
// der Mitarbeiter abonniert die Feed-URL einmalig in Google/Apple Kalender,
// danach hält der Kalender-Anbieter den Plan automatisch aktuell, da der
// Feed bei jedem Abruf live aus dem aktuellen Dienstplan generiert wird.
model EmployeeCalendarSync {
  employeeId String   @id
  enabled    Boolean  @default(false)
  token      String   @unique @default(cuid())
  updatedAt  DateTime @updatedAt
}

// Ergänzung 4 zu 02_ONBOARDING_CHAT.md: kurzfristige, nur für die jeweils
// aktuelle Planungsperiode gültige Besonderheiten (z.B. "Diese Woche findet
// ein Sommerfest statt"). Bewusst getrennt von LocationOnboarding, da diese
// Hinweise gerade NICHT dauerhaft gelten sollen.
model SchedulingPeriodNote {
  id         String   @id @default(cuid())
  locationId String
  weekStart  String
  note       String
  createdAt  DateTime @default(now())
}

// ─── Echte Authentifizierung & Einladungen (Demo → Produktivsystem) ────────
// Ersetzt die rein clientseitige Demo-Anmeldung durch echte, gehashte
// Passwörter. employeeId/locationId/customerName verknüpfen den Account
// optional mit den bestehenden mock-data Entitäten, ohne diese anzufassen.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String
  employeeId    String?
  locationId    String?
  customerId    String?
  customerName  String?
  totpSecret    String?
  totpEnabled   Boolean  @default(false)
  phone         String?
  phoneVerified Boolean  @default(false)
  smsOtpEnabled Boolean  @default(false)
  bereichIds    String[] @default([])
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InvitationToken {
  id           String    @id @default(cuid())
  token        String    @unique
  email        String
  role         String
  name         String?
  customerId   String?
  customerName String?
  employeeId   String?
  locationId   String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
}

// Separat von InvitationToken: zielt auf bestehende Accounts (nicht auf
// Neuanlage) und ist bewusst kurzlebig (1 Stunde statt 7 Tage).
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─── Echte Datenpersistenz: Mitarbeiter/Kunden/Standorte ───────────────────
// Ersetzt die bisherigen EMPLOYEES/LOCATIONS/CUSTOMERS Arrays in
// mock-data.ts. Bewusst ohne @relation (wie der Rest des Schemas) – alle
// Querverweise (locationId, adminId, employeeId, ...) bleiben lose Strings,
// damit bestehende Tabellen (EmployeeProfile, User, ...) unverändert bleiben.
model Location {
  id            String   @id @default(cuid())
  customerId    String?
  name          String
  address       String
  city          String
  state         String
  zip           String?
  street        String?
  houseNumber   String?
  country       String?
  bundesland    String?
  employeeCount Int      @default(0)
  adminId       String
  bereichId     String?
  active        Boolean  @default(true)

  // §126 Regelpaket: die von OKUN fuer diesen Standort programmierte
  // Dienstplanlogik. Die ID ist der Dateiname im Rechendienst.
  rulePackId    String?

  // §127 Freischaltung der Dienstplanung.
  //
  // Das Geschaeftsmodell: alles ausser der Dienstplanung ist Standard und
  // laeuft sofort. Die Dienstplanung wird je Kunde von Hand gebaut — bis dahin
  // bleibt sie gesperrt. Ein Kunde, der ungebaute Dienstplanung ausprobiert,
  // bekommt einen schlechten Plan und ein falsches Bild vom Produkt.
  //
  // Freischalten darf nur OKUN, nicht der Kunde.
  dienstplanungFrei      Boolean   @default(false)
  dienstplanungFreiSeit  String?
  dienstplanungFreiVon   String?
  /// Was dem Kunden angezeigt wird, solange gesperrt ist
  dienstplanungHinweis   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Employee {
  id                String   @id @default(cuid())
  customerId        String?
  name              String
  email             String   @unique
  role              String
  locationId        String?
  weeklyHours       Float
  position          String
  hoursBalance      Float    @default(0)
  vacationDaysTotal Int      @default(30)
  vacationDaysUsed  Int      @default(0)
  preferences       Json?
  active            Boolean  @default(true)
  joinedAt          String
  hasChildren       Boolean?
  phone             String?
  birthDate         String?
  roleType          String?
  employmentType    String?
  gruppe            String?
  bereich           String?
  multiGroupCapable Boolean?
  fixedLocations    String?
  qualifications    String[] @default([])
  allowedTasks      String[] @default([])
  avatarUrl         String?
  workDaysPerWeek   Int?
  workDays          String[] @default([])
  dailyTargetHours  Float?
  fixedOffDays      String[] @default([])

  // §128 Einschraenkung der Verarbeitung nach Art.18 DSGVO.
  // Gesetzt, wenn nach dem Austritt geloescht wurde, aber Lohn- und
  // Steuerunterlagen aufbewahrt werden muessen. Solange gesetzt, darf mit
  // diesen Daten nur noch das geschehen, wofuer das Gesetz sie verlangt.
  datenGesperrtAm    DateTime?
  datenGesperrtGrund String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// §129 Nachrichten zwischen Mitarbeitern.
///
/// Zwei Arten, mit unterschiedlichen Regeln:
///
///   direkt  Ein Gespraech zwischen genau zwei Personen. Niemand sonst kommt
///           hinein — auch die Leitung nicht, auch OKUN nicht. Der schluessel
///           haelt fest, welche beiden es sind, und verhindert, dass zwei
///           Raeume fuer dasselbe Gespraech entstehen, wenn beide gleichzeitig
///           schreiben.
///
///   gruppe  Von der Standortleitung eroeffnet und verwaltet. Wer darin liest,
///           ist Mitglied — Verwalten und Mitlesen sind absichtlich zwei
///           verschiedene Dinge.
model ChatRaum {
  id           String    @id @default(cuid())
  customerId   String
  /// Leer bei Raeumen der Unternehmensebene — eine Geschaeftsfuehrung sitzt an
  /// keinem einzelnen Standort.
  locationId   String?
  /// direkt | gruppe
  art          String
  /// Nur bei Gruppen
  name         String?
  beschreibung String?
  /// Nur bei Direktchats: beide Benutzerkennungen sortiert, mit "|" verbunden
  schluessel   String?   @unique
  erstelltVon  String?
  /// Geschlossene Gruppen bleiben lesbar, nehmen aber nichts Neues mehr auf
  archiviertAm DateTime?
  /// Fuer die Sortierung der Liste ohne teure Unterabfrage
  letzteAktivitaet DateTime @default(now())
  createdAt    DateTime  @default(now())

  mitglieder   ChatMitglied[]
  nachrichten  ChatNachricht[]

  @@index([customerId])
  @@index([locationId, art])
}

model ChatMitglied {
  id            String    @id @default(cuid())
  raumId        String
  /// §131 Das Benutzerkonto ist der Teilnehmer, nicht der Mitarbeiterdatensatz.
  ///
  /// Eine Standortleitung und eine Geschaeftsfuehrung haben ein Konto, aber
  /// nicht zwingend einen Mitarbeiterdatensatz — mit employeeId als Schluessel
  /// konnten sie den Chat gar nicht benutzen.
  userId        String
  /// Gefuellt, wenn das Konto zu einem Mitarbeiter gehoert. Nur dafuer da,
  /// dass eine Loeschung nach Art.17 DSGVO die Nachrichten findet.
  employeeId    String?
  /// mitglied | leitung — "leitung" darf Mitglieder aendern und schliessen
  rolle         String    @default("mitglied")
  /// Bis wohin gelesen wurde; alles Spaetere ist ungelesen
  gelesenBis    DateTime?
  beigetretenAm DateTime  @default(now())

  raum          ChatRaum  @relation(fields: [raumId], references: [id], onDelete: Cascade)

  @@unique([raumId, userId])
  @@index([employeeId])
  @@index([userId])
}

model ChatNachricht {
  id           String   @id @default(cuid())
  raumId       String
  /// §131 Der Absender als Benutzerkonto; "system" fuer Hinweise im Verlauf.
  userId       String
  /// Gefuellt, wenn das Konto zu einem Mitarbeiter gehoert — fuer die Loeschung.
  employeeId   String?
  /// Der Name zum Zeitpunkt des Schreibens — spaetere Aenderungen sollen
  /// alte Nachrichten nicht rueckwirkend umschreiben.
  absenderName String
  text         String
  /// text | system — Systemhinweise ("ist beigetreten") sehen anders aus
  art          String   @default("text")
  createdAt    DateTime @default(now())

  raum         ChatRaum @relation(fields: [raumId], references: [id], onDelete: Cascade)

  @@index([raumId, createdAt])
  @@index([employeeId])
}

/// §128 Was bei einer Loeschung tatsaechlich geschehen ist.
///
/// Ohne diesen Nachweis laesst sich gegenueber der Aufsichtsbehoerde weder
/// belegen, dass geloescht wurde, noch warum etwas bleiben musste. Der Bericht
/// haelt je Datenart fest, was passiert ist — er enthaelt Zahlen und
/// Begruendungen, keine Personendaten.
model Loeschvorgang {
  id                 String   @id @default(cuid())
  employeeId         String
  customerId         String?
  personName         String
  /// loeschung = auf Verlangen oder nach Austritt, aufraeumen = abgelaufene Frist
  art                String   @default("loeschung")
  angestossenVon     String
  angestossenVonName String?
  bericht            Json
  createdAt          DateTime @default(now())

  @@index([employeeId])
  @@index([customerId])
}

model Customer {
  id                 String    @id @default(cuid())
  name               String
  contactName        String
  contactEmail       String
  status             String
  plan               String
  seatsLicensed      Int
  seatsUsed          Int       @default(0)
  locationsCount     Int       @default(0)
  createdAt          String
  renewalDate        String?
  notes              String?
  roles              String[]  @default([])
  deletedAt          DateTime?
  updatedAt          DateTime  @updatedAt
  legalContractDate  String?
  legalContractNotes String?
}

model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String
  userEmail  String
  userRole   String
  action     String
  entityType String
  entityId   String?
  customerId String?
  details    Json?
}

// ─── Bereich: optionale Zwischenebene Company → Bereich → Location ───────────
// Reine Organisationsstruktur, keine neue Rolle. Company-Nutzer mit bereichIds
// (Bereichsleiter) sehen ausschließlich Standorte und Mitarbeiter in ihren Bereichen.

model Bereich {
  id          String   @id @default(cuid())
  customerId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

// ─── Echte Datenpersistenz: Dienstplanung, Zeiterfassung, Urlaub, Plattform ─
// Ersetzt die übrigen, bisher noch simulierten Arrays in src/lib/mock-data.ts
// (Shift, ScheduleEntry, TimeLog, VacationRequest, ...). Wie der Rest des
// Schemas ohne @relation – alle Querverweise bleiben lose Strings. Bewusst
// ohne Seed-Daten: Produktivsysteme starten leer, echte Daten entstehen durch
// echte Nutzung der Anwendung ("keine Demo-Daten mehr").

model Shift {
  id                     String   @id @default(cuid())
  name                   String
  type                   String
  startTime              String
  endTime                String
  color                  String
  bgColor                String
  minStaff               Int      @default(1)
  locationId             String
  requiredQualifications String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model ScheduleEntry {
  id              String   @id @default(cuid())
  employeeId      String
  shiftId         String
  date            String
  locationId      String
  status          String   @default("planned")
  note            String?
  reason          String?
  startTime       String?
  endTime         String?
  gruppe          String?
  funktion        String?
  isSubstitution  Boolean  @default(false)
  substitutionFor String?
  taskBlocks      Json?
  createdAt       DateTime @default(now())
}

model LocationPlanningRules {
  locationId            String    @id
  maxWeeklyHours        Int       @default(40)
  restHours             Int       @default(11)
  maxConsecutiveDays    Int       @default(5)
  fridayLateMax         Int       @default(2)
  mondayEarlyMax        Int       @default(3)
  fridayEarlyMax        Int       @default(3)
  weekendMax            Int       @default(2)
  considerWishes        Boolean   @default(true)
  balanceHoursAccount   Boolean   @default(true)
  autoBreakDeduction    Boolean   @default(false)
  breakThresholdMinutes Int       @default(360)
  breakDeductionMinutes Int       @default(30)
  breakRulesExtractedAt DateTime?
  updatedAt             DateTime  @updatedAt
}

model TimeLog {
  id           String    @id @default(cuid())
  employeeId   String
  date         String
  clockIn      String
  clockInAt    DateTime?
  clockOut     String?
  totalMinutes Int?
  breakMinutes Int?
  breakStart   String?
  breakStartAt DateTime?
  note         String?
  locationId   String

  /// §137 Woher dieser Eintrag stammt: app | offline | leitung.
  ///
  /// Im Funkloch entsteht der Stempel auf dem Telefon und wird spaeter
  /// uebertragen — dann zaehlt die Zeit des Stempelns, nicht die des
  /// Hochladens. Die Standortleitung muss beim Monatsabschluss sehen, welcher
  /// Eintrag vom Geraet kam und welcher nachgereicht wurde: Der Zeitpunkt
  /// entscheidet ueber Lohn, und was niemand pruefen kann, ist eine
  /// Behauptung.
  quelle       String?

  createdAt    DateTime  @default(now())
}

model VacationRequest {
  id           String   @id @default(cuid())
  employeeId   String
  employeeName String
  locationId   String
  locationName String
  startDate    String
  endDate      String
  days         Int
  reason       String?
  status       String   @default("pending")
  submittedAt  String
  respondedAt  String?
  respondedBy  String?
  createdAt    DateTime @default(now())
}

model SwapRequest {
  id                 String  @id @default(cuid())
  requesterId        String
  requesterName      String
  requesterDate      String
  requesterShiftId   String
  targetEmployeeId   String
  targetEmployeeName String
  targetDate         String
  targetShiftId      String
  message            String?
  status             String  @default("pending")
  submittedAt        String
  respondedAt        String?
  locationId         String
}

model WishSubmission {
  id                 String  @id @default(cuid())
  employeeId         String
  employeeName       String
  locationId         String
  date               String
  preferredShiftType String
  reason             String?
  importance         String  @default("normal")
  submittedAt        String
  status             String  @default("pending")
  conflictInfo       Json?
}

model VacationPlanPreference {
  employeeId            String   @id
  hasChildren           Boolean  @default(false)
  schoolHolidayPriority String?
  preferredMonths       Int[]    @default([])
  preferredPeriod       String?
  notes                 String?
  priority              String   @default("medium")
  updatedAt             DateTime @updatedAt
}

model VacationRules {
