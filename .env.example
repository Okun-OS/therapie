# Anthropic API Key – required for AI schedule generation
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL – required for the Vertretungsmanagement module
# On Railway: add a "PostgreSQL" plugin, it injects DATABASE_URL automatically
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Public base URL of this deployment – required so that links inside invitation
# and password-reset e-mails point at your real domain instead of the internal
# host the app happens to be bound to (e.g. localhost behind a reverse proxy).
# Example: https://app.okun-systems.com (no trailing slash)
APP_URL=

# Resend – required for real e-mail delivery on substitution requests.
# Without this set, e-mails are only logged to the server console.
# Get a key at https://resend.com/
RESEND_API_KEY=

# Verify your own sending domain in Resend before going live — the default
# onboarding@resend.dev sender only delivers to your own Resend account email,
# not to real customers. Once verified, set e.g.: EMAIL_FROM="OKUN Workforce <einladung@deine-domain.de>"
EMAIL_FROM=

# Web Push (VAPID) – required for real push notifications (PWA).
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Session cookie signing secret – required in production (login fails to start without it).
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# One-time setup key – required to create the very first account (OKUN-Administrator)
# on a fresh database via /setup. There is no other way to create the first account,
# since every other account is created by an invitation from an existing account.
# Generate with: openssl rand -hex 32
# Visit /setup once after deploying, then you may unset this variable again – the
# route also refuses to run once any account already exists.
SETUP_SECRET=

# CP-SAT Solver Service – required for automated schedule generation.
# Without this set every planning run fails immediately with a configuration error.
# On Railway: deploy solver-service/ as a separate service and point this at its
# internal URL, e.g. http://solver.railway.internal:8000
# Locally: start the solver with  cd solver-service && uvicorn main:app --port 8000
# then set SOLVER_SERVICE_URL=http://localhost:8000
SOLVER_SERVICE_URL=

# §135 Der Schluessel fuer den stuendlichen Fundelauf. Mindestens 24 Zeichen,
# nur Buchstaben und Ziffern. Derselbe Wert muss in der Sitzungsumgebung stehen,
# in der der Lauf startet — siehe FEHLERKREISLAUF.md.
FUNDE_TOKEN=

# §143 Wohin Nachrichten aus dem Kanal "OKUN Workforce" gehen. Ohne sie wird
# nichts verschickt und nichts kaputtgemacht: Der Versand schreibt eine Zeile
# ins Protokoll, die Nachricht steht trotzdem im Kanal.
OKUN_SUPPORT_EMAIL=

# §139 Der Dienstkonto-Schluessel aus Firebase, als EINE Zeile. Ohne ihn
# verschickt die App aus dem Store keine Benachrichtigung — siehe APP-STORES.md.
FCM_SERVICE_ACCOUNT=

# ─── §152/§153 Angaben ueber OKUN selbst ────────────────────────────────────
#
# Sie stehen im Impressum (§5 DDG), in der Datenschutzerklaerung (Art. 13
# DSGVO) und im Verarbeitungsverzeichnis (Art. 30 DSGVO). Bewusst aus der
# Umgebung und nicht einprogrammiert: Eine Anschrift im Quelltext wird beim
# naechsten Umzug garantiert vergessen.
#
# Solange sie fehlen, sagen die Seiten das ausdruecklich — sie taeuschen keine
# Vollstaendigkeit vor. Vor dem ersten echten Kunden gehoeren sie gesetzt.

# Firmenname, wie er im Register steht
OKUN_FIRMA=
# Ladungsfaehige Anschrift, mehrzeilig erlaubt — §5 Abs. 1 Nr. 1 DDG
OKUN_ANSCHRIFT=
# Vertretungsberechtigte Person — §5 Abs. 1 Nr. 1 DDG, §18 Abs. 2 MStV
OKUN_VERTRETEN=
# E-Mail fuer Betroffene und Behoerden — §5 Abs. 1 Nr. 2 DDG
OKUN_KONTAKT=
# Registergericht und Nummer, sobald vorhanden — §5 Abs. 1 Nr. 4 DDG
OKUN_REGISTER=
# Umsatzsteuer-Identifikationsnummer, sobald vorhanden — §5 Abs. 1 Nr. 6 DDG
OKUN_USTID=
# Datenschutzbeauftragter, sobald benannt — Art. 13 Abs. 1 lit. b DSGVO.
# Pflicht nach §38 BDSG in der Regel ab zwanzig Personen mit staendiger
# automatisierter Verarbeitung.
OKUN_DSB=
