# Anthropic API Key – required for AI schedule generation
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL – required for the Vertretungsmanagement module
# On Railway: add a "PostgreSQL" plugin, it injects DATABASE_URL automatically
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Resend – required for real e-mail delivery on substitution requests.
# Without this set, e-mails are only logged to the server console.
# Get a key at https://resend.com/
RESEND_API_KEY=

# Verify your own sending domain in Resend before going live — the default
# onboarding@resend.dev sender only delivers to your own Resend account email,
# not to real customers. Once verified, set e.g.: EMAIL_FROM="OKUN Workforce <einladung@deine-domain.de>"
EMAIL_FROM=

# Web Push (VAPID) – required for real push notifications (PWA).
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Session cookie signing secret – required in production (login fails to start without it).
# Generate with: openssl rand -hex 32
SESSION_SECRET=
