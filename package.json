{
  "name": "dienstplan-saas",
  "version": "0.1.0",
  "private": true,
  "description": "OKUN Workforce — Recruiting, Personalakte, Dienstplanung, Zeiterfassung und Lohnabrechnung in einem System",
  "author": "OKUN <kontakt@okun.de>",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "prisma migrate deploy; next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "pruefen": "node pruefungen/lauf.mjs",
    "pruefen:alles": "npm run test && npm run pruefen",
    "app:sync": "cap sync",
    "app:ios": "cap sync ios && cap open ios",
    "app:android": "cap sync android && cap open android",
    "postinstall": "prisma generate",
    "seed": "npx tsx --env-file-if-exists=.env prisma/seed.ts",
    "seed:kita": "npx tsx --env-file-if-exists=.env prisma/seed-kita-demo.ts",
    "seed:schaufenster": "npx tsx --env-file-if-exists=.env prisma/seed-schaufenster.ts",
    "kunde:wohngruppe": "node scripts/kunde-wohngruppe.mjs",
    "schaufenster": "node scripts/schaufenster.mjs",
    "umlagen:import": "npx tsx --env-file-if-exists=.env prisma/import-umlagekatalog.ts",
    "logo:aufbauen": "node scripts/logo-aufbauen.mjs",
    "logo:negativ": "node scripts/logo-negativ.mjs",
    "schrift:messen": "node scripts/schrift-messen.mjs",
    "desktop": "electron desktop/haupt.js",
    "desktop:bauen": "electron-builder --project desktop --linux --win",
    "desktop:linux": "electron-builder --project desktop --linux",
    "desktop:win": "electron-builder --project desktop --win",
    "desktop:mac": "electron-builder --project desktop --mac",
    "desktop:pruefen": "xvfb-run -a --server-args=\"-screen 0 1400x900x24\" node pruefungen/desktop/huelle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@prisma/client": "^5.22.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lohnsteuerrechner": "1.0.7",
    "lucide-react": "^0.390.0",
    "next": "^14.2.35",
    "pdf-lib": "^1.17.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.9.0",
    "resend": "^6.14.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.0.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
